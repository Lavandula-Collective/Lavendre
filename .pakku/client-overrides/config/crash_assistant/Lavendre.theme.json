{
  "name": "Lavendre",
  "author": "Aerhazu",
  "dark": false,

  "colors": {
    "lavender": "#7E74A8",
    "lavenderDark": "#6C6393",
    "background": "#F7F7F7",
    "surface": "#FFFFFF",
    "border": "#D9D9D9",
    "text": "#2E2E2E",
    "textSecondary": "#6B6B6B",
    "selection": "#E8E4F3",
    "success": "#4E8D63",
    "warning": "#C9913A",
    "error": "#C34F4F"
  },

  "ui": {
    "Panel.background": "background",
    "Viewport.background": "background",

    "Separator.foreground": "border",

    "Component.borderColor": "border",
    "Component.focusColor": "lavender",

    "Label.foreground": "text",
    "Label.disabledForeground": "textSecondary",

    "TextField.background": "surface",
    "TextField.foreground": "text",
    "TextField.borderColor": "border",
    "TextField.selectionBackground": "selection",

    "TextArea.background": "surface",
    "TextArea.foreground": "text",
    "TextArea.selectionBackground": "selection",

    "Button.background": "surface",
    "Button.foreground": "text",
    "Button.borderColor": "border",

    "Button.default.background": "lavender",
    "Button.default.foreground": "#FFFFFF",
    "Button.default.borderColor": "lavenderDark",

    "Button.hoverBackground": "#F1EEF8",
    "Button.pressedBackground": "#E6E1F2",

    "ScrollBar.track": "background",
    "ScrollBar.thumb": "#C8C8C8",

    "ProgressBar.background": "#ECECEC",
    "ProgressBar.foreground": "lavender",

    "CheckBox.foreground": "text",

    "Link.activeForeground": "lavenderDark",

    "Tree.selectionBackground": "selection",
    "List.selectionBackground": "selection",
