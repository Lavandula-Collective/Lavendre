###     PATTERN                     DESCRIPTION                     EXAMPLE
###   filename.ext          Ignores specific file globally        secrets.txt
###       dir/                  Ignores entire directory         node_modules/
###      *.ext                  Wildcard for file types       *.log (all log files)
###        ?                 Matches exactly one character    file?.txt (file1.txt)
###      [abc]                  Matches set characters            log[0-9].txt
###        !                   Negation (Do NOT ignore)      Negation (Do not ignore)
###      /**/                   Matches nested folders              **/logs/
###       #                     Starts a comment line          # API keys below

### Minecraft ###
run/*
!run/config/
run/config/*
!run/packwiz-installer.jar
!run/options.txt

### Mod Configs ###

!run/config/fancymenu/
!run/config/isxander-main-menu-credits.json
!run/config/betterf3.json
!run/config/chatpatches.json
!run/config/sounds
### Presence Footsteps ###
!run/config/presencefootsteps/
run/config/presencefootsteps/*
!run/config/presencefootsteps/userconfig.json
### Xaero ###
!run/config/xaero/
run/config/xaero/*
!run/config/xaero/minimap/
run/config/xaero/minimap/*
!run/config/xaero/minimap/profiles/
run/config/xaero/minimap/profiles*
!
### Crash Assistant ###
!run/config/crash_assistant/
run/config/crash_assistant/*
!run/config/crash_assistant/config.toml
### JEI ###
